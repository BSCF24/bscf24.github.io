---
import { Image } from 'astro:assets';
import Base from './Base.astro';
import metadata from '../data/metadata.json';
import { getImageAsset } from '../utils/images';
import { getVideoEmbedInfo, getYouTubeEmbedUrl } from '../utils/video';
import type { ProjectVideoItem, ProjectPublicationItem } from '../data/initiatives';

interface Props {
  title: string;
  description?: string;
  featured?: string;
  images?: string[];
  pageUrl?: string;
  tag?: string;
  video?: string;
  videos?: ProjectVideoItem[];
  publications?: ProjectPublicationItem[];
}

const {
  title,
  description,
  featured,
  images = [],
  pageUrl = Astro.url.pathname,
  tag,
  video,
  videos = [],
  publications = []
} = Astro.props;

const videoInfo = video ? getVideoEmbedInfo(video) : null;
const resolvedFeatured = featured ? await getImageAsset(featured) : null;
const resolvedGalleryImages = await Promise.all(
  images.map(async (img) => ({
    original: img,
    resolved: await getImageAsset(img)
  }))
);

const resolvedPublications = await Promise.all(
  publications.map(async (pub) => ({
    ...pub,
    resolvedImage: pub.image ? await getImageAsset(pub.image) : null
  }))
);

const shareUrl = `${metadata.url}${pageUrl}`;
const whatsappShareUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(title)}%20${shareUrl}`;
const facebookShareUrl = `https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`;
const linkedinShareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`;
const ogImageUrl = resolvedFeatured ? resolvedFeatured.src : featured;

const hasVideos = videos && videos.length > 0;
const reels = hasVideos ? videos.filter(v => v.category === 'reel') : [];
const ovcs = hasVideos ? videos.filter(v => v.category === 'ovc') : [];
const podcasts = hasVideos ? videos.filter(v => v.category === 'podcast') : [];
---

<Base title={title} description={description} featured={ogImageUrl} pageUrl={pageUrl}>
  <div class="project-page-wrapper">
    {featured && (
      <div class="notion-cover">
        {resolvedFeatured ? (
          <Image src={resolvedFeatured} alt={`${title} cover`} class="cover-img" loading="eager" />
        ) : (
          <img src={featured} alt={`${title} cover`} class="cover-img" />
        )}
      </div>
    )}

    <article class:list={['project-content', { 'has-series': hasVideos, 'no-cover': !featured }]}>
      <div class="detail-hero-header">
        {tag && (
          <div class="project-badge-wrap">
            <span class="project-category-badge">{tag}</span>
          </div>
        )}
        <h1 class="project-title">{title}</h1>
        {hasVideos && (
          <div class="project-campaign-tagline">
            <span class="campaign-tagline-pill">Supported By</span>
            <span class="campaign-tagline-title">Digital Democracy Initiative • Sub-Grant No. DDIBAN015</span>
          </div>
        )}
        <div class="title-accent-line"></div>
      </div>

      <!-- Share Buttons Section -->
      <div class="share-container">
        <span class="share-label">Share:</span>
        <div class="share-buttons">
          <a href={facebookShareUrl} target="_blank" rel="noopener" aria-label="Share on Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
          </a>
          <a href={linkedinShareUrl} target="_blank" rel="noopener" aria-label="Share on LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
          </a>
          <a href={whatsappShareUrl} target="_blank" rel="noopener" aria-label="Share on WhatsApp">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 1 1-7.6-10.6 8.38 8.38 0 0 1 9 6.9Z"></path></svg>
          </a>
          <button onclick="copyToClipboard()" id="copyBtn" aria-label="Copy Link">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
          </button>
        </div>
      </div>

      <!-- Justified Body Content -->
      <div class="project-body">
        <slot />
      </div>

      <!-- Grant Context Card -->
      {hasVideos && (
        <div class="grant-context-card">
          <div class="grant-badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            Digital Democracy Initiative • Sub-Grant No. DDIBAN015
          </div>
          <div class="grant-details-grid">
            <div class="grant-detail">
              <span class="detail-label">Project</span>
              <span class="detail-value">Democracy in Reels</span>
            </div>
            <div class="grant-detail">
              <span class="detail-label">Timeline</span>
              <span class="detail-value">25 June – 31 August 2026</span>
            </div>
            <div class="grant-detail">
              <span class="detail-label">Digital Reach</span>
              <span class="detail-value">573,211 Online (Target: 500,000)</span>
            </div>
            <div class="grant-detail">
              <span class="detail-label">Civic Media Scope</span>
              <span class="detail-value">30 Productions (20 Reels, 5 OVCs, 5 Podcasts)</span>
            </div>
          </div>
        </div>
      )}

      <!-- Dedicated Publications & Civic Impact Section -->
      {resolvedPublications && resolvedPublications.length > 0 && (
        <section class="publications-section">
          <div class="publications-intro">
            <span class="gallery-tag">Policy Engagement & Impact</span>
            <h2 class="gallery-heading">Publications & Civic Impact</h2>
            <div class="gallery-decoration"></div>
            <p class="publications-lead">
              Translating digital civic storytelling and youth engagement into municipal policy proposals and institutional partnerships.
            </p>
          </div>

          <div class="publications-grid">
            {resolvedPublications.map((pub) => (
              <article class="publication-card" id={pub.id}>
                {pub.resolvedImage ? (
                  <div class="pub-card-layout with-visual">
                    <div class="pub-visual-col">
                      <Image 
                        src={pub.resolvedImage} 
                        alt={pub.title} 
                        class="pub-photo" 
                        width={700} 
                        height={480} 
                        loading="lazy" 
                      />
                      {pub.imageCaption && (
                        <p class="pub-photo-caption">
                          <span class="caption-icon">📷</span> {pub.imageCaption}
                        </p>
                      )}
                    </div>
                    <div class="pub-details-col">
                      <div class="pub-meta-row">
                        <span class="pub-type-badge">{pub.type}</span>
                        {pub.organization && (
                          <span class="pub-org-badge">{pub.organization}</span>
                        )}
                        <span class="pub-date-badge">📅 {pub.date}</span>
                      </div>
                      <h3 class="pub-item-title">{pub.title}</h3>
                      <p class="pub-item-subtitle">{pub.subtitle}</p>
                      <p class="pub-item-summary">{pub.summary}</p>
                      {pub.tags && pub.tags.length > 0 && (
                        <div class="pub-tags-list">
                          {pub.tags.map(t => (
                            <span class="pub-tag-pill">{t}</span>
                          ))}
                        </div>
                      )}
                    </div>
                  </div>
                ) : (
                  <div class="pub-card-layout standalone-text">
                    <div class="pub-details-col">
                      <div class="pub-meta-row">
                        <span class="pub-type-badge case-study">{pub.type}</span>
                        {pub.organization && (
                          <span class="pub-org-badge">{pub.organization}</span>
                        )}
                        <span class="pub-date-badge">📅 {pub.date}</span>
                      </div>
                      <h3 class="pub-item-title">{pub.title}</h3>
                      <p class="pub-item-subtitle">{pub.subtitle}</p>
                      <p class="pub-item-summary">{pub.summary}</p>
                      {pub.tags && pub.tags.length > 0 && (
                        <div class="pub-tags-list">
                          {pub.tags.map(t => (
                            <span class="pub-tag-pill">{t}</span>
                          ))}
                        </div>
                      )}
                    </div>
                  </div>
                )}
              </article>
            ))}
          </div>
        </section>
      )}

      <!-- Media Section: Series Archive vs Single Video vs Gallery -->
      {hasVideos ? (
        <section class="video-series-section">
          <div class="series-header">
            <div class="gallery-intro">
              <span class="gallery-tag">Civic Media Archive</span>
              <h2 class="gallery-heading">All 30 Video Productions</h2>
              <div class="gallery-decoration"></div>
            </div>

            <!-- Category Filter Tabs -->
            <div class="series-filter-tabs">
              <button class="series-tab-btn active" data-vfilter="all">
                All Videos <span class="tab-count">{videos.length}</span>
              </button>
              <button class="series-tab-btn" data-vfilter="reel">
                Civic Reels <span class="tab-count">{reels.length}</span>
              </button>
              <button class="series-tab-btn" data-vfilter="ovc">
                OVCs <span class="tab-count">{ovcs.length}</span>
              </button>
              <button class="series-tab-btn" data-vfilter="podcast">
                Podcasts <span class="tab-count">{podcasts.length}</span>
              </button>
            </div>
          </div>

          <!-- Video Cards Grid -->
          <div class="series-cards-grid">
            {videos.map(v => {
              const ytEmbed = getYouTubeEmbedUrl(v.youtube);
              const isReel = v.category === 'reel';
              return (
                <div class:list={['series-card', `category-${v.category}`, { 'is-vertical': isReel }]} data-vcategory={v.category}>
                  <div class:list={['card-media-wrapper', isReel ? 'aspect-9-16' : 'aspect-16-9']}>
                    {ytEmbed ? (
                      <iframe
                        src={ytEmbed}
                        title={v.title}
                        loading="lazy"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen
                      ></iframe>
                    ) : (
                      <div class="card-video-placeholder">
                        <div class="placeholder-icon">
                          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                        </div>
                        <span class="placeholder-title">Social Exclusive Video</span>
                        <span class="placeholder-note">Watch directly on Facebook</span>
                        {v.facebook && (
                          <a href={v.facebook} target="_blank" rel="noopener noreferrer" class="btn-direct-watch">
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16"><path d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951z"/></svg>
                            Watch on Facebook
                          </a>
                        )}
                      </div>
                    )}
                  </div>

                  <div class="card-details">
                    <div class="card-tags-row">
                      <span class:list={['id-tag', `tag-${v.category}`]}>{v.id}</span>
                      <span class="duration-tag">⏱ {v.duration}</span>
                      <span class="date-tag">{v.date}</span>
                    </div>

                    <h3 class="card-video-title">{v.title}</h3>
                    <div class="card-theme-line">
                      <span class="theme-label">Theme:</span> {v.theme}
                    </div>
                    <p class="card-video-desc">{v.description}</p>

                    <div class="card-social-footer">
                      <span class="footer-label">Watch on:</span>
                      <div class="social-icon-links">
                        {v.youtube && (
                          <a href={v.youtube} target="_blank" rel="noopener noreferrer" class="social-icon-btn yt" title="Watch on YouTube" aria-label="Watch on YouTube">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M8.051 1.999h.089c.822.003 4.987.033 6.11.335a2.01 2.01 0 0 1 1.415 1.42c.101.38.172.883.22 1.402l.01.104.022.26.008.104c.065.914.073 1.77.074 1.957v.075c-.001.194-.01 1.108-.082 2.06l-.008.105-.022.26-.01.104c-.048.519-.119 1.023-.22 1.402a2.007 2.007 0 0 1-1.415 1.42c-1.16.312-5.569.334-6.18.335h-.142c-.309 0-1.587-.006-2.927-.052l-.17-.006-.087-.004-.171-.007-.171-.007c-1.11-.049-2.167-.128-2.654-.26a2.007 2.007 0 0 1-1.415-1.419c-.111-.417-.185-.986-.235-1.558L.09 9.82l-.008-.104A31.4 31.4 0 0 1 0 7.68v-.123c.002-.215.01-.958.064-1.778l.007-.103.022-.26.01-.104c.048-.519.119-1.023.22-1.402a2.007 2.007 0 0 1 1.415-1.42c.487-.13 1.544-.21 2.654-.26l.17-.007.172-.006.086-.003.171-.007A99.788 99.788 0 0 1 7.858 2h.193zM6.4 5.209v4.818l4.157-2.408L6.4 5.209z"/></svg>
                          </a>
                        )}
                        {v.facebook && (
                          <a href={v.facebook} target="_blank" rel="noopener noreferrer" class="social-icon-btn fb" title="Watch on Facebook" aria-label="Watch on Facebook">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951z"/></svg>
                          </a>
                        )}
                        {v.instagram && (
                          <a href={v.instagram} target="_blank" rel="noopener noreferrer" class="social-icon-btn ig" title="Watch on Instagram" aria-label="Watch on Instagram">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.917 3.917 0 0 0-1.417.923A3.927 3.927 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.916 3.916 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.926 3.926 0 0 0-.923-1.417A3.911 3.911 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0h.003zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599.28.28.453.546.598.92.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.47 2.47 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.478 2.478 0 0 1-.92-.598 2.48 2.48 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233 0-2.136.008-2.388.046-3.231.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92.28-.28.546-.453.92-.598.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045v.002zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92zm-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217zm0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334z"/></svg>
                          </a>
                        )}
                        {v.linkedin && (
                          <a href={v.linkedin} target="_blank" rel="noopener noreferrer" class="social-icon-btn li" title="Watch on LinkedIn" aria-label="Watch on LinkedIn">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"/></svg>
                          </a>
                        )}
                      </div>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </section>
      ) : videoInfo ? (
        <section class="video-wrapper">
          <div class="video-intro">
            <span class="video-tag">Media</span>
            <h2 class="video-heading">Project Video</h2>
            <div class="video-decoration"></div>
          </div>
          <div class="video-container">
            {videoInfo.type === 'iframe' ? (
              <iframe
                src={videoInfo.src}
                title={`${title} video`}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              ></iframe>
            ) : (
              <video controls preload="metadata">
                <source src={videoInfo.src} type="video/mp4" />
                Your browser does not support the video tag.
              </video>
            )}
          </div>
        </section>
      ) : (
        images && images.length > 0 && (
          <section class="gallery-wrapper">
            <div class="gallery-intro">
              <span class="gallery-tag">Visuals</span>
              <h2 class="gallery-heading">Gallery</h2>
              <div class="gallery-decoration"></div>
            </div>
            
            <div class="gallery-grid">
              {resolvedGalleryImages.map(item => (
                <div class="gallery-card">
                  {item.resolved ? (
                    <Image src={item.resolved} alt="Project gallery image" loading="lazy" width={600} height={400} />
                  ) : (
                    <img src={item.original} alt="Project gallery image" loading="lazy" />
                  )}
                </div>
              ))}
            </div>
          </section>
        )
      )}
    </article>
  </div>
</Base>

<script is:inline>
    function copyToClipboard() {
        const url = window.location.href;
        navigator.clipboard.writeText(url).then(() => {
            const btn = document.getElementById('copyBtn');
            if (btn) {
                btn.style.color = "#00b894"; // Visual feedback (green)
                setTimeout(() => {
                    btn.style.color = ""; 
                }, 2000);
            }
        });
    }

    document.addEventListener('DOMContentLoaded', () => {
        const tabButtons = document.querySelectorAll('.series-tab-btn');
        const cards = document.querySelectorAll('.series-card');

        tabButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                tabButtons.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');

                const filter = btn.getAttribute('data-vfilter');
                cards.forEach(card => {
                    if (filter === 'all' || card.getAttribute('data-vcategory') === filter) {
                        card.classList.remove('hidden-card');
                    } else {
                        card.classList.add('hidden-card');
                    }
                });
            });
        });
    });
</script>

<style>
    .project-page-wrapper {
        background: #fff;
        padding-top: 96px;
    }

    .notion-cover {
        width: 100%;
        height: 60vh; 
        min-height: 240px;
        max-height: 520px; 
        overflow: hidden;
        margin-bottom: 36px;
        position: relative;
        background: #f8fafc;
    }

    .cover-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center; 
    }

    .project-content {
        max-width: 800px;
        margin: 0 auto;
        padding: 0 24px 100px 24px;
    }

    .project-content.no-cover .detail-hero-header {
        padding-top: 24px;
    }

    .detail-hero-header {
        margin-bottom: 20px;
    }

    .project-badge-wrap {
        margin-bottom: 12px;
    }

    .project-category-badge {
        display: inline-block;
        padding: 4px 14px;
        background: #f1f5f9;
        color: #0f172a;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: capitalize;
        border-radius: 9999px;
        border: 1px solid #cbd5e1;
    }

    .project-campaign-tagline {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin: 4px 0 16px 0;
        padding: 6px 14px;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 8px;
        font-size: 0.92rem;
    }

    .campaign-tagline-pill {
        display: inline-block;
        padding: 2px 8px;
        background: #16a34a;
        color: #ffffff;
        font-size: 0.72rem;
        font-weight: 700;
