---
import { Image } from 'astro:assets';
import logoSvg from '../assets/images/logo.svg';
import '../styles/footer.css';
---

<footer class="footer-container">
    <div class="footer-main">
        <div class="footer-about">
            <div class="logo-container">
                <Image class="footer-logo" src={logoSvg} alt="BSCF Logo" width={64} height={64} />
            </div>
            <p>BSCF is a socio-cultural forum for the youth of Bangladesh, dedicated to fostering a generation of leaders and innovators. We aim to create a vibrant community that promotes our rich cultural heritage while embracing modernity and progress.</p>
        </div>
        <div class="footer-links">
            <div class="footer-column">
                <h5>Quick Links</h5>
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/about">About Us</a></li>
                    <li><a href="/initiatives">Initiatives</a></li>
                    <li><a href="/team">Team</a></li>
                </ul>
            </div>
            <div class="footer-column">
                <h5>Get Involved</h5>
                <ul>
                    <li><a href="/apply">Join Us</a></li>
                    <li><a href="/contact">Contact</a></li>
                    <li><a href="/donate">Invest In Us</a></li>
                </ul>
            </div>
            <div class="footer-column">
                <h5>Policies</h5>
                <ul>
                    <li><a href="/contents/pdfs/Anti-Corruption Policy BSCF.pdf" target="_blank">Anti-Corruption</a></li>
                    <li><a href="/contents/pdfs/Anti-Sexual Harassment Policy BSCF.pdf" target="_blank">Anti-Sexual Harassment</a></li>
                    <li><a href="/contents/pdfs/Child Protection Policy BSCF.pdf" target="_blank">Child Protection</a></li>
                    <li><a href="/contents/pdfs/Conflict of Interest Policy & Declaration BSCF.pdf" target="_blank">Conflict of Interest</a></li>
                    <li><a href="/contents/pdfs/Data Protection Policy BSCF.pdf" target="_blank">Data Protection</a></li>
                    <li><a href="/contents/pdfs/Financial Management Policy BSCF.pdf" target="_blank">Financial Management</a></li>
                    <li><a href="/contents/pdfs/Gender Equality Policy BSCF.pdf" target="_blank">Gender Equality</a></li>
                    <li><a href="/contents/pdfs/HR Policy BSCF.pdf" target="_blank">HR Policy</a></li>
                </ul>
            </div>
            <div class="footer-column">
                <h5>Follow Us</h5>
                <div class="social-icons">
                    <a href="https://www.facebook.com/profile.php?id=61556581893985" target="_blank" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                    <a href="mailto:bscf24@gmail.com" aria-label="Email"><i class="bi bi-envelope-fill"></i></a>
                    <a href="https://www.linkedin.com/company/bscf-dev" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                </div>
            </div>
        </div>
    </div>
    <div class="footer-bottom">
        <p>&copy; 2026 Bangladesh Socio-Cultural Forum. All Rights Reserved.</p>
        <p>Developed & Maintained by <a href="https://github.com/BSCF-BD/bscf.dev" target="_blank">BSCF Tech Team</a></p>
    </div>
</footer>
