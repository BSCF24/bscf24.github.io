---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getInitiatives, formatInitiativeDate, slugify } from '../../data/initiatives';
import { getImageAsset } from '../../utils/images';

const rawInitiatives = getInitiatives();

const initiatives = await Promise.all(
  rawInitiatives.map(async (item) => ({
    ...item,
    resolvedFeatured: item.featured ? await getImageAsset(item.featured) : null
  }))
);

// Extract unique tags in the same order as in 11ty
const uniqueTags: string[] = [];
initiatives.forEach(item => {
  if (item.tag && !uniqueTags.includes(item.tag)) {
    uniqueTags.push(item.tag);
  }
});
---

<Base title="All Initiatives">
  <div class="archive-container">
    <div class="archive-intro">
      <span class="archive-tag">Portfolio</span>
      <h1 class="archive-title">All Initiatives</h1>
      
      <div class="filter-wrapper">
        <button class="filter-btn active" data-filter="all">All</button>
        {uniqueTags.map(tag => (
          <button class="filter-btn" data-filter={slugify(tag)}>
            {tag}
          </button>
        ))}
      </div>

      <div class="archive-line"></div>
    </div>

    <div class="item-list" id="item-grid">
      {initiatives.map(item => (
        <a href={`/initiatives/${item.slug}/`} 
           class="item-card" 
           data-category={slugify(item.tag)}>
          <div class="card-image-wrapper">
            {item.resolvedFeatured ? (
              <Image src={item.resolvedFeatured} alt={item.title} width={600} height={400} loading="lazy" />
            ) : item.featured ? (
              <img src={item.featured} alt={item.title} loading="lazy" />
            ) : (
              <div class="image-placeholder"></div>
            )}
          </div>
          
          <div class="card-content">
            <div class="card-metadata">
              <span class="card-tag">{item.tag}</span>
              <span class="card-date">{formatInitiativeDate(item.date)}</span>
            </div>
            <h2 class="card-title">{item.title}</h2>
            <p class="card-description">{item.description}</p>
            <span class="card-link">View item →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Base>

<style>
  /* FILTER STYLING */
  .filter-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 2rem 0 1rem 0;
  }

  .filter-btn {
    background: transparent;
    border: 1px solid var(--border-color);
    padding: 0.5rem 1.25rem;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    color: var(--text-muted);
  }

  .filter-btn:hover { border-color: var(--accent); color: var(--text-main); }
  .filter-btn.active { background: var(--accent, #000); border-color: var(--accent, #000); color: #fff; }

  /* item GRID - UPDATED FOR 3 COLUMNS */
  .item-list {
    display: grid;
    /* This forces 3 columns exactly */
    grid-template-columns: repeat(3, 1fr); 
    gap: 2rem;
  }

  .item-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .item-card.hidden { display: none; }

  .item-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 24px rgba(0,0,0,0.06);
  }

  .card-image-wrapper {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #f9f9f9;
  }

  .card-image-wrapper img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .card-content { padding: 1.5rem; flex-grow: 1; display: flex; flex-direction: column; }
  .card-metadata { display: flex; justify-content: space-between; margin-bottom: 0.75rem; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; }
  .card-tag { color: var(--accent); background: rgba(0,0,0,0.04); padding: 2px 8px; border-radius: 4px; }
  .card-date { color: var(--text-muted); }
  .card-title { font-size: 1.25rem; font-weight: 700; margin-bottom: 0.5rem; }
  .card-description { font-size: 0.95rem; line-height: 1.5; color: var(--text-muted); margin-bottom: 1.5rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .card-link { margin-top: auto; font-size: 0.85rem; font-weight: 700; color: var(--accent); opacity: 0.6; }

  /* RESPONSIVE BREAKPOINTS */
  @media (max-width: 1024px) {
    .item-list { grid-template-columns: repeat(2, 1fr); } /* 2 columns for tablets */
  }

  @media (max-width: 768px) {
    .item-list { grid-template-columns: 1fr; } /* 1 column for mobile */
  }
</style>

<script is:inline>
  document.querySelectorAll('.filter-btn').forEach(button => {
    button.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
      button.classList.add('active');

      const filterValue = button.getAttribute('data-filter');
      const posts = document.querySelectorAll('.item-card');

      posts.forEach(post => {
        if (filterValue === 'all' || post.getAttribute('data-category') === filterValue) {
          post.classList.remove('hidden');
        } else {
          post.classList.add('hidden');
        }
      });
    });
  });
</script>
