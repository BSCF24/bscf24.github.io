    }

    resize(newW: number, newH: number, isMobile: boolean): void {
      const oldW = this.width || 1;
      const oldH = this.height || 1;
      const scaleX = newW / oldW;
      const scaleY = newH / oldH;
      this.width = newW;
      this.height = newH;

      for (const s of this.stars) {
        s.x *= scaleX;
        s.y *= scaleY;
      }

      if (isMobile && this.qualityScale > 0.6) {
        this.qualityScale = 0.6;
        this.seed();
      } else if (!isMobile && this.qualityScale === 0.6) {
        this.qualityScale = 1;
        this.seed();
      }

      this.buildMilkyWay();
    }

    reduceQuality(): void {
