    halo.addColorStop(0, coreColor);
    halo.addColorStop(0.18, midHalo);
    halo.addColorStop(0.55, outerHalo);
    halo.addColorStop(1, 'rgba(0, 0, 0, 0)');
    g.fillStyle = halo;
    g.fillRect(0, 0, size, size);

