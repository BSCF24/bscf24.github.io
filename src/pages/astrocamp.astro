  class Starfield {
    stars: Star[] = [];
    milkyWayCanvas: HTMLCanvasElement;
    mwOffsetX = 0;
    mwOffsetY = 0;
    desktopCount = 200;
    qualityScale = 1;
    width = 1;
    height = 1;
    parallaxX = 0;
    parallaxY = 0;
    targetMouseX = 0;
    targetMouseY = 0;
    sprites: Sprites;

    constructor(width: number, height: number, sprites: Sprites) {
      this.width = width;
      this.height = height;
      this.sprites = sprites;
      this.qualityScale = width < 768 ? 0.6 : 1;
      this.milkyWayCanvas = document.createElement('canvas');
      this.buildMilkyWay();
      this.seed();
