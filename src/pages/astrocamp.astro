    hGrad.addColorStop(0, 'rgba(255,255,255,0)');
    hGrad.addColorStop(0.5, spikeTint);
    hGrad.addColorStop(1, 'rgba(255,255,255,0)');
    g.fillStyle = hGrad;
    g.fillRect(2, half - 0.7, size - 4, 1.4);

