    buildMilkyWay(): void {
      const w = Math.max(1, Math.ceil(this.width * 1.25));
      const h = Math.max(1, Math.ceil(this.height * 1.25));
      this.milkyWayCanvas.width = w;
      this.milkyWayCanvas.height = h;
      const g = this.milkyWayCanvas.getContext('2d')!;
      g.clearRect(0, 0, w, h);

      g.save();
      g.translate(w * 0.5, h * 0.5);
      g.rotate(-0.48);

      const bandGrad = g.createLinearGradient(0, -h * 0.24, 0, h * 0.24);
      bandGrad.addColorStop(0, 'rgba(30, 58, 138, 0)');
      bandGrad.addColorStop(0.28, 'rgba(99, 102, 241, 0.04)');
      bandGrad.addColorStop(0.5, 'rgba(148, 163, 254, 0.065)');
      bandGrad.addColorStop(0.72, 'rgba(14, 116, 144, 0.04)');
      bandGrad.addColorStop(1, 'rgba(30, 58, 138, 0)');
      g.fillStyle = bandGrad;
      g.fillRect(-w, -h * 0.26, w * 2, h * 0.52);

      for (let i = 0; i < 14; i++) {
        const px = (i / 13 - 0.5) * w * 1.1;
        const py = Math.sin(i * 1.7) * 0.07 * h;
        const r = Math.min(w, h) * (0.14 + (i % 3) * 0.04);
        const dust = g.createRadialGradient(px, py, 0, px, py, r);
        dust.addColorStop(0, 'rgba(191, 219, 254, 0.045)');
        dust.addColorStop(1, 'rgba(191, 219, 254, 0)');
        g.fillStyle = dust;
        g.fillRect(px - r, py - r, r * 2, r * 2);
      }

      for (let i = 0; i < 300; i++) {
        const sx = (Math.random() - 0.5) * w * 1.35;
        const gauss = (Math.random() + Math.random() + Math.random()) / 3 - 0.5;
        const sy = gauss * h * 0.42;
        const alpha = 0.03 + Math.random() * 0.05;
        g.fillStyle = `rgba(226, 232, 240, ${alpha.toFixed(3)})`;
        g.fillRect(sx, sy, 0.75, 0.75);
      }
      g.restore();
    }

    seed(): void {
      const total = Math.max(50, Math.round(this.desktopCount * this.qualityScale));
      const farCount = Math.round(total * 0.6);
      const midCount = Math.round(total * 0.3);
      const nearCount = Math.min(10, Math.max(4, total - farCount - midCount));
      this.stars = [];

      for (let i = 0; i < farCount; i++) {
        this.stars.push({
          x: Math.random() * this.width,
          y: Math.random() * this.height,
          radius: 0.4 + Math.random() * 0.5,
          layer: 0,
          color: '#e2e8f0',
          warm: false,
