  function makeSpikeSprite(size: number, coreColor: string, midHalo: string, outerHalo: string, spikeTint: string): HTMLCanvasElement {
    const c = document.createElement('canvas');
    c.width = size;
    c.height = size;
    const g = c.getContext('2d')!;
    const half = size / 2;

