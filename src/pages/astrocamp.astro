      const goalY = (allowMouseParallax ? this.targetMouseY * 140 : 0) - scrollY * 0.35;
      const lerpFactor = 1 - Math.exp(-dt * 5.5);
      this.parallaxX += (goalX - this.parallaxX) * lerpFactor;
      this.parallaxY += (goalY - this.parallaxY) * lerpFactor;

