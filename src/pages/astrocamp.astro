      };

      return [orion, taurus, gemini];
    }

    resize(w: number, h: number): void {
      this.width = w;
      this.height = h;
    }

    projectRaDec(raH: number, decDeg: number, starfield: Starfield): Point {
      const isMobile = this.width < 768;
      // Orion center RA ~5.58h, Dec ~0.5° positioned upper-centre/right on desktop
      const originX = isMobile ? this.width * 0.56 : this.width * 0.61;
      const originY = isMobile ? this.height * 0.27 : this.height * 0.34;
      const scale = isMobile
        ? Math.min(this.width, this.height) * 0.0085
        : Math.min(this.width, this.height) * 0.0112;

      // Facing South: +RA (East) lies leftward, +Dec (North) lies upward
      const xBase = originX - (raH - 5.58) * 14.2 * scale;
      const yBase = originY - (decDeg - 0.5) * 1.0 * scale;

      // Mid-layer parallax (0.03)
      return {
        x: xBase + starfield.parallaxX * 0.03,
        y: yBase + starfield.parallaxY * 0.03
      };
    }

    getGeminidRadiant(starfield: Starfield): Point {
      // Near Castor in Gemini (RA ~7.5h, Dec +32°)
      return this.projectRaDec(7.48, 32.0, starfield);
    }

    updateAndDraw(
      ctx: CanvasRenderingContext2D,
      dt: number,
      timeSec: number,
      starfield: Starfield,
      cursorX: number,
      cursorY: number,
      cursorActive: boolean,
      isFinePointer: boolean,
      animate: boolean,
      warpFactor: number
    ): void {
      // 1. Draw real December sky constellation stars (always visible, participating in mid-layer parallax)
      const projectedGroups = this.skyGroups.map((group) => {
        const starMap = new Map<string, { star: SkyStarDef; pos: Point }>();
        let sumX = 0;
        let sumY = 0;
        for (const st of group.stars) {
          const pos = this.projectRaDec(st.raH, st.decDeg, starfield);
          starMap.set(st.id, { star: st, pos });
          sumX += pos.x;
          sumY += pos.y;
        }
        const count = Math.max(1, group.stars.length);
        return {
          group,
          starMap,
          centerX: sumX / count,
          centerY: sumY / count
        };
      });

      for (const { starMap } of projectedGroups) {
        for (const { star, pos } of starMap.values()) {
          const twinkle = animate
            ? 0.72 + 0.28 * Math.sin(timeSec * 0.9 + star.phase)
            : 0.9;

          if (warpFactor > 0.01) {
            starfield.drawWarpStreak(ctx, pos.x, pos.y, star.spike ? 1.55 : 1.05, warpFactor, star.color, twinkle);
          }

          if (star.spike) {
            ctx.globalAlpha = twinkle;
            const sprite = star.spike === 'warm' ? this.sprites.spikeStarWarm : this.sprites.spikeStar;
            const size = star.radius * 12;
            ctx.drawImage(sprite, pos.x - size / 2, pos.y - size / 2, size, size);
          } else {
            ctx.globalAlpha = twinkle * 0.72;
            const glowSize = star.radius * 7.5;
            const glowSprite = star.color.startsWith('#ff') ? this.sprites.warmStarGlow : this.sprites.softStarGlow;
            ctx.drawImage(glowSprite, pos.x - glowSize / 2, pos.y - glowSize / 2, glowSize, glowSize);
            ctx.globalAlpha = twinkle;
            ctx.fillStyle = star.color;
            ctx.beginPath();
            ctx.arc(pos.x, pos.y, star.radius, 0, Math.PI * 2);
            ctx.fill();
          }
        }
      }
      ctx.globalAlpha = 1;

      if (!animate || !this.enabled) {
        for (const g of this.skyGroups) g.lineAlpha = 0;
        this.edges.clear();
        return;
      }

      // 2. Constellation lines + labels (desktop: cursor <= 200px; touch: 4s rotation every 12s)
      const touchCycleSlot = Math.floor(timeSec / 12) % this.skyGroups.length;
      const touchSlotPhase = timeSec % 12;
      const touchShowCurrent = !isFinePointer && touchSlotPhase >= 1.5 && touchSlotPhase <= 5.5;

      for (let idx = 0; idx < projectedGroups.length; idx++) {
        const { group, starMap, centerX, centerY } = projectedGroups[idx];
        let isHovered = false;

        if (isFinePointer && cursorActive) {
          if (Math.hypot(cursorX - centerX, cursorY - centerY) <= 200) {
            isHovered = true;
          } else {
            for (const { pos } of starMap.values()) {
              if (Math.hypot(cursorX - pos.x, cursorY - pos.y) <= 200) {
                isHovered = true;
                break;
              }
            }
          }
        } else if (!isFinePointer) {
          isHovered = touchShowCurrent && idx === touchCycleSlot;
        }

        const targetAlpha = isHovered ? 1 : 0;
        const step = dt / 0.4; // 400 ms fade
        if (group.lineAlpha < targetAlpha) {
          group.lineAlpha = Math.min(1, group.lineAlpha + step);
        } else if (group.lineAlpha > targetAlpha) {
          group.lineAlpha = Math.max(0, group.lineAlpha - step);
        }

        if (group.lineAlpha > 0.005) {
          ctx.save();
          ctx.strokeStyle = `rgba(186, 230, 253, ${(0.18 * group.lineAlpha).toFixed(4)})`;
          ctx.lineWidth = 0.85;
          ctx.beginPath();
          for (const [idA, idB] of group.lines) {
            const a = starMap.get(idA);
            const b = starMap.get(idB);
            if (a && b) {
              ctx.moveTo(a.pos.x, a.pos.y);
              ctx.lineTo(b.pos.x, b.pos.y);
            }
          }
          ctx.stroke();

          // Tiny uppercase letter-spaced label
          const labelPos = this.projectRaDec(group.labelAnchor.raH, group.labelAnchor.decDeg, starfield);
          ctx.fillStyle = `rgba(224, 242, 254, ${(0.45 * group.lineAlpha).toFixed(4)})`;
          ctx.font = '300 10px "Jost", sans-serif';
          ctx.textAlign = 'center';
          const spaced = group.name.split('').join(' ');
          ctx.fillText(spaced, labelPos.x, labelPos.y);
          ctx.restore();
        }
      }

      // 3. Ambient cursor proximity constellation threads (desktop only)
      if (!isFinePointer) {
        this.edges.clear();
        return;
      }

      for (const edge of this.edges.values()) {
        edge.target = 0;
      }

      if (cursorActive) {
        const nearCursor: Array<{ idx: number; sx: number; sy: number; distCursor: number }> = [];
        for (let i = 0; i < starfield.stars.length; i++) {
          const s = starfield.stars[i];
          const { sx, sy } = starfield.getScreenPos(s);
          const dx = sx - cursorX;
          const dy = sy - cursorY;
          const d2 = dx * dx + dy * dy;
          if (d2 <= 160 * 160) {
            nearCursor.push({ idx: i, sx, sy, distCursor: Math.sqrt(d2) });
          }
        }

        const candidates: Array<{ key: string; x1: number; y1: number; x2: number; y2: number; target: number; dist: number }> = [];
        for (let a = 0; a < nearCursor.length; a++) {
          for (let b = a + 1; b < nearCursor.length; b++) {
            const p1 = nearCursor[a];
            const p2 = nearCursor[b];
            const dx = p1.sx - p2.sx;
            const dy = p1.sy - p2.sy;
            const d2 = dx * dx + dy * dy;
            if (d2 <= 110 * 110) {
              const dist = Math.sqrt(d2);
              const pairFade = 1 - dist / 110;
              const cursorFade = 1 - Math.max(p1.distCursor, p2.distCursor) / 160;
              const target = Math.min(0.12, 0.12 * pairFade * (0.4 + 0.6 * cursorFade));
              const key = p1.idx < p2.idx ? `${p1.idx}-${p2.idx}` : `${p2.idx}-${p1.idx}`;
              candidates.push({ key, x1: p1.sx, y1: p1.sy, x2: p2.sx, y2: p2.sy, target, dist });
            }
          }
        }

        candidates.sort((a, b) => a.dist - b.dist);
        for (const c of candidates.slice(0, 12)) {
          const existing = this.edges.get(c.key);
          if (existing) {
            existing.x1 = c.x1;
            existing.y1 = c.y1;
            existing.x2 = c.x2;
            existing.y2 = c.y2;
            existing.target = c.target;
          } else {
            this.edges.set(c.key, {
              x1: c.x1,
              y1: c.y1,
              x2: c.x2,
              y2: c.y2,
              alpha: 0.001,
              target: c.target
            });
          }
        }
      }

      const fadeStep = dt / 0.3;
      ctx.lineWidth = 0.6;
      for (const [key, edge] of this.edges.entries()) {
        if (edge.alpha < edge.target) {
          edge.alpha = Math.min(edge.target, edge.alpha + 0.12 * fadeStep);
        } else if (edge.alpha > edge.target) {
          edge.alpha = Math.max(edge.target, edge.alpha - 0.12 * fadeStep);
        }

        if (edge.alpha <= 0.001 && edge.target === 0) {
          this.edges.delete(key);
          continue;
        }

        ctx.strokeStyle = `rgba(207, 227, 255, ${edge.alpha.toFixed(4)})`;
        ctx.beginPath();
        ctx.moveTo(edge.x1, edge.y1);
        ctx.lineTo(edge.x2, edge.y2);
        ctx.stroke();
      }
    }
  }

  class Planet {
    canvas: HTMLCanvasElement;
    size = 0;
    viewportW = 1;
    viewportH = 1;

    constructor(width: number, height: number) {
      this.canvas = document.createElement('canvas');
      this.resize(width, height);
    }

    resize(width: number, height: number): void {
      this.viewportW = width;
      this.viewportH = height;
      const targetSize = Math.round(Math.min(Math.max(width, height) * 0.56, 560));
      if (Math.abs(targetSize - this.size) < 24 && this.size > 0) return;
      this.size = Math.max(260, targetSize);
      this.prerender();
    }

    prerender(): void {
      const s = this.size;
      this.canvas.width = s;
      this.canvas.height = s;
      const g = this.canvas.getContext('2d')!;
      g.clearRect(0, 0, s, s);

      const cx = s * 0.5;
      const cy = s * 0.5;
      const r = s * 0.27;
      const ringTilt = -0.34;

      g.save();
      g.translate(cx, cy);
      g.rotate(ringTilt);
      for (let i = 0; i < 3; i++) {
        g.beginPath();
        g.ellipse(0, 0, r * (1.72 + i * 0.12), r * (0.36 + i * 0.03), 0, Math.PI, Math.PI * 2);
        g.strokeStyle = i === 1 ? 'rgba(94, 234, 212, 0.14)' : 'rgba(129, 140, 248, 0.10)';
        g.lineWidth = i === 1 ? 3 : 1.5;
        g.stroke();
      }
      g.restore();

      const atmo = g.createRadialGradient(cx - r * 0.22, cy - r * 0.22, r * 0.78, cx, cy, r * 1.24);
      atmo.addColorStop(0, 'rgba(45, 212, 191, 0)');
      atmo.addColorStop(0.76, 'rgba(45, 212, 191, 0.16)');
      atmo.addColorStop(0.88, 'rgba(99, 102, 241, 0.10)');
      atmo.addColorStop(1, 'rgba(99, 102, 241, 0)');
      g.fillStyle = atmo;
      g.beginPath();
      g.arc(cx, cy, r * 1.24, 0, Math.PI * 2);
      g.fill();

      g.save();
      g.beginPath();
      g.arc(cx, cy, r, 0, Math.PI * 2);
      g.clip();

      const sphereGrad = g.createRadialGradient(cx - r * 0.45, cy - r * 0.45, r * 0.1, cx + r * 0.15, cy + r * 0.15, r * 1.35);
      sphereGrad.addColorStop(0, '#172a4a');
      sphereGrad.addColorStop(0.45, '#0b1429');
      sphereGrad.addColorStop(1, '#03060f');
      g.fillStyle = sphereGrad;
      g.fillRect(cx - r, cy - r, r * 2, r * 2);

      const rimGrad = g.createLinearGradient(cx - r, cy - r, cx + r * 0.6, cy + r * 0.6);
      rimGrad.addColorStop(0, 'rgba(45, 212, 191, 0.58)');
      rimGrad.addColorStop(0.5, 'rgba(56, 189, 248, 0.28)');
      rimGrad.addColorStop(1, 'rgba(99, 102, 241, 0.02)');
      g.strokeStyle = rimGrad;
      g.lineWidth = 3.5;
      g.beginPath();
      g.arc(cx, cy, r - 1.5, Math.PI * 0.88, Math.PI * 1.88);
      g.stroke();
      g.restore();

      g.save();
      g.translate(cx, cy);
      g.rotate(ringTilt);
      for (let i = 0; i < 3; i++) {
        g.beginPath();
        g.ellipse(0, 0, r * (1.72 + i * 0.12), r * (0.36 + i * 0.03), 0, 0, Math.PI);
        g.strokeStyle = i === 1 ? 'rgba(94, 234, 212, 0.22)' : 'rgba(129, 140, 248, 0.15)';
        g.lineWidth = i === 1 ? 3 : 1.5;
        g.stroke();
      }
      g.restore();
    }

    draw(ctx: CanvasRenderingContext2D, timeSec: number, animate: boolean, scrollProgress: number): void {
      const breathe = animate ? 1 + Math.sin(timeSec * 0.18) * 0.008 : 1;
      const scrollScale = 1 + scrollProgress * 0.14;
      const angle = animate ? Math.sin(timeSec * 0.08) * 0.015 : 0;
      const drawSize = this.size * breathe * scrollScale;
      const px = this.viewportW - drawSize * 0.36;
      const py = this.viewportH - drawSize * 0.34 - scrollProgress * this.viewportH * 0.15;

      ctx.save();
      ctx.globalAlpha = 0.82;
      ctx.translate(px, py);
      ctx.rotate(angle);
      ctx.drawImage(this.canvas, -drawSize / 2, -drawSize / 2, drawSize, drawSize);
      ctx.restore();
      ctx.globalAlpha = 1;
    }
  }

  interface Point {
    x: number;
    y: number;
  }

  interface SatelliteEntity {
    isStation: boolean;
    beaconColor: 'red' | 'cyan';
    active: boolean;
    waitTimer: number;
    elapsed: number;
    duration: number;
    p0: Point;
    p1: Point;
    p2: Point;
    p3: Point;
    rotation: number;
    rotSpeed: number;
    trail: Point[];
    beaconPhase: number;
  }

  class Satellites {
    entities: SatelliteEntity[] = [];
    sprites: Sprites;
    width = 1;
    height = 1;

    constructor(width: number, height: number, sprites: Sprites) {
      this.width = width;
      this.height = height;
      this.sprites = sprites;

      this.entities.push(this.createEntity(false, 'red', 1.5));
      this.entities.push(this.createEntity(false, 'cyan', 8.5));
      this.entities.push(this.createEntity(true, 'cyan', 14.0));
    }

    createEntity(isStation: boolean, beaconColor: 'red' | 'cyan', initialWait: number): SatelliteEntity {
      return {
        isStation,
        beaconColor,
        active: false,
        waitTimer: initialWait,
        elapsed: 0,
        duration: 30,
        p0: { x: 0, y: 0 },
        p1: { x: 0, y: 0 },
        p2: { x: 0, y: 0 },
        p3: { x: 0, y: 0 },
        rotation: Math.random() * Math.PI * 2,
        rotSpeed: (Math.random() < 0.5 ? -1 : 1) * (isStation ? 0.08 : 0.16),
        trail: [],
        beaconPhase: Math.random() * Math.PI * 2
      };
    }

    edgePoint(edge: number): Point {
      const m = 48;
      if (edge === 0) return { x: Math.random() * this.width, y: -m };
      if (edge === 1) return { x: this.width + m, y: Math.random() * this.height * 0.78 };
      if (edge === 2) return { x: Math.random() * this.width, y: this.height + m };
      return { x: -m, y: Math.random() * this.height * 0.78 };
    }

    spawnPass(ent: SatelliteEntity): void {
      const startEdge = Math.floor(Math.random() * 4);
      const endEdge = (startEdge + 1 + Math.floor(Math.random() * 2)) % 4;
      ent.p0 = this.edgePoint(startEdge);
      ent.p3 = this.edgePoint(endEdge);
      ent.p1 = {
        x: this.width * (0.2 + Math.random() * 0.6),
        y: this.height * (0.12 + Math.random() * 0.55)
      };
      ent.p2 = {
        x: this.width * (0.2 + Math.random() * 0.6),
        y: this.height * (0.12 + Math.random() * 0.55)
      };
      ent.duration = ent.isStation ? 32 + Math.random() * 13 : 25 + Math.random() * 20;
      ent.elapsed = 0;
      ent.trail = [];
      ent.active = true;
    }

    resize(newW: number, newH: number): void {
      const sx = newW / (this.width || 1);
      const sy = newH / (this.height || 1);
      this.width = newW;
      this.height = newH;
      for (const ent of this.entities) {
        for (const p of [ent.p0, ent.p1, ent.p2, ent.p3, ...ent.trail]) {
          p.x *= sx;
          p.y *= sy;
        }
      }
    }

    bezierPoint(t: number, p0: Point, p1: Point, p2: Point, p3: Point): Point {
      const u = 1 - t;
      const tt = t * t;
      const uu = u * u;
      const uuu = uu * u;
      const ttt = tt * t;
      return {
        x: uuu * p0.x + 3 * uu * t * p1.x + 3 * u * tt * p2.x + ttt * p3.x,
        y: uuu * p0.y + 3 * uu * t * p1.y + 3 * u * tt * p2.y + ttt * p3.y
      };
    }

    update(dt: number): void {
      for (const ent of this.entities) {
        if (!ent.active) {
          ent.waitTimer -= dt;
          if (ent.waitTimer <= 0) {
            this.spawnPass(ent);
          }
          continue;
        }

        ent.elapsed += dt;
        ent.rotation += ent.rotSpeed * dt;
        const t = Math.min(1, ent.elapsed / ent.duration);
        const pos = this.bezierPoint(t, ent.p0, ent.p1, ent.p2, ent.p3);

        const last = ent.trail[ent.trail.length - 1];
        if (!last || Math.hypot(pos.x - last.x, pos.y - last.y) >= 3) {
          ent.trail.push(pos);
          if (ent.trail.length > 40) ent.trail.shift();
        }

        if (t >= 1) {
          ent.active = false;
          ent.trail = [];
          ent.waitTimer = ent.isStation ? 60 + Math.random() * 30 : 5 + Math.random() * 10;
        }
      }
    }

    drawPanel(ctx: CanvasRenderingContext2D, x: number, y: number, w: number, h: number): void {
      ctx.fillStyle = '#3b5998';
      ctx.strokeStyle = 'rgba(148, 163, 184, 0.55)';
      ctx.lineWidth = 0.6;
      ctx.fillRect(x, y, w, h);
      ctx.strokeRect(x, y, w, h);

      ctx.strokeStyle = 'rgba(191, 219, 254, 0.35)';
      ctx.lineWidth = 0.45;
      ctx.beginPath();
      ctx.moveTo(x + w * 0.5, y);
      ctx.lineTo(x + w * 0.5, y + h);
      ctx.moveTo(x, y + h * 0.5);
      ctx.lineTo(x + w, y + h * 0.5);
      ctx.stroke();
    }

    draw(ctx: CanvasRenderingContext2D, timeSec: number): void {
      for (const ent of this.entities) {
        if (!ent.active || ent.trail.length === 0) continue;

        if (ent.trail.length > 1) {
          ctx.lineWidth = ent.isStation ? 1.3 : 1;
          for (let i = 1; i < ent.trail.length; i++) {
            const frac = i / ent.trail.length;
            const alpha = frac * 0.15;
            ctx.strokeStyle = ent.beaconColor === 'red'
              ? `rgba(226, 232, 240, ${alpha.toFixed(3)})`
              : `rgba(125, 211, 252, ${alpha.toFixed(3)})`;
            ctx.beginPath();
            ctx.moveTo(ent.trail[i - 1].x, ent.trail[i - 1].y);
            ctx.lineTo(ent.trail[i].x, ent.trail[i].y);
            ctx.stroke();
          }
        }

        const head = ent.trail[ent.trail.length - 1];
        const scale = ent.isStation ? 1.6 : 1;

        ctx.save();
        ctx.translate(head.x, head.y);
        ctx.rotate(ent.rotation);
        ctx.scale(scale, scale);

        if (ent.isStation) {
          ctx.strokeStyle = '#cbd5e1';
          ctx.lineWidth = 1.2;
          ctx.beginPath();
          ctx.moveTo(-12, 0);
          ctx.lineTo(12, 0);
          ctx.stroke();

          ctx.fillStyle = '#e2e8f0';
          ctx.fillRect(-3, -2.5, 6, 5);

          this.drawPanel(ctx, -11.5, -8, 6, 5);
          this.drawPanel(ctx, -11.5, 3, 6, 5);
          this.drawPanel(ctx, 5.5, -8, 6, 5);
          this.drawPanel(ctx, 5.5, 3, 6, 5);
        } else {
          ctx.fillStyle = '#e2e8f0';
          ctx.fillRect(-2.5, -2, 5, 4);
          this.drawPanel(ctx, -10.5, -2.5, 7, 5);
          this.drawPanel(ctx, 3.5, -2.5, 7, 5);
        }

        const pulse = 0.25 + 0.75 * Math.max(0, Math.sin(timeSec * Math.PI * 2 + ent.beaconPhase));
        const beaconSprite = ent.beaconColor === 'red' ? this.sprites.redBeacon : this.sprites.cyanBeacon;
        ctx.globalAlpha = pulse;
        ctx.drawImage(beaconSprite, -6, -6, 12, 12);
        ctx.restore();
        ctx.globalAlpha = 1;
      }
    }
  }

  interface MeteorEntity {
    x: number;
    y: number;
    vx: number;
    vy: number;
    elapsed: number;
    duration: number;
    tailLen: number;
  }

  class Meteors {
    active: MeteorEntity[] = [];
    spawnTimer = 2.6;
    width = 1;
    height = 1;
    sprites: Sprites;

    constructor(width: number, height: number, sprites: Sprites) {
      this.width = width;
      this.height = height;
      this.sprites = sprites;
    }

    resize(w: number, h: number): void {
      this.width = w;
      this.height = h;
    }

    nextInterval(): number {
      const isGeminidWindow = Date.now() < GEMINIDS_PEAK_END;
      return isGeminidWindow ? 3 + Math.random() * 2 : 4 + Math.random() * 3;
    }

    spawn(radiant: Point): void {
      const useRadiant = Math.random() < 0.6;
      if (useRadiant) {
        const theta = Math.random() * Math.PI * 2;
        const offsetDist = 24 + Math.random() * 75;
        const speed = 520 + Math.random() * 260;
        this.active.push({
          x: radiant.x + Math.cos(theta) * offsetDist,
          y: radiant.y + Math.sin(theta) * offsetDist,
          vx: Math.cos(theta) * speed,
          vy: Math.sin(theta) * speed,
          elapsed: 0,
          duration: 0.6 + Math.random() * 0.6,
          tailLen: 80 + Math.random() * 100
        });
        return;
      }

      const fromLeft = Math.random() < 0.7;
      const angleDeg = 20 + Math.random() * 20;
      const rad = (angleDeg * Math.PI) / 180;
      const speed = 520 + Math.random() * 280;
      const dir = fromLeft ? 1 : -1;

      this.active.push({
        x: fromLeft ? this.width * (0.08 + Math.random() * 0.6) : this.width * (0.35 + Math.random() * 0.55),
        y: this.height * (0.04 + Math.random() * 0.41),
        vx: Math.cos(rad) * speed * dir,
        vy: Math.sin(rad) * speed,
        elapsed: 0,
        duration: 0.6 + Math.random() * 0.6,
        tailLen: 80 + Math.random() * 100
      });
    }

    update(dt: number, radiant: Point): void {
      this.spawnTimer -= dt;
      if (this.spawnTimer <= 0) {
        if (this.active.length === 0) {
          this.spawn(radiant);
          if (Math.random() < 0.12) this.spawn(radiant);
        }
        this.spawnTimer = this.nextInterval();
      }

      for (let i = this.active.length - 1; i >= 0; i--) {
        const m = this.active[i];
        m.elapsed += dt;
        const progress = Math.min(1, m.elapsed / m.duration);
        const easeOutSpeed = 1 - progress * 0.55;
        m.x += m.vx * easeOutSpeed * dt;
        m.y += m.vy * easeOutSpeed * dt;
        if (progress >= 1) {
          this.active.splice(i, 1);
        }
      }
    }

    draw(ctx: CanvasRenderingContext2D): void {
      for (const m of this.active) {
        const p = Math.min(1, m.elapsed / m.duration);
        const alpha = p < 0.15 ? p / 0.15 : 1 - (p - 0.15) / 0.85;
        const speedMag = Math.hypot(m.vx, m.vy) || 1;
        const ux = m.vx / speedMag;
        const uy = m.vy / speedMag;
        const tx = m.x - ux * m.tailLen;
        const ty = m.y - uy * m.tailLen;

        ctx.save();
        ctx.globalAlpha = Math.max(0, alpha);
        const grad = ctx.createLinearGradient(m.x, m.y, tx, ty);
        grad.addColorStop(0, 'rgba(255, 255, 255, 0.92)');
        grad.addColorStop(0.35, 'rgba(186, 230, 253, 0.45)');
        grad.addColorStop(1, 'rgba(56, 189, 248, 0)');
        ctx.strokeStyle = grad;
        ctx.lineWidth = 2.2;
        ctx.lineCap = 'round';
        ctx.beginPath();
        ctx.moveTo(m.x, m.y);
        ctx.lineTo(tx, ty);
        ctx.stroke();

        ctx.drawImage(this.sprites.meteorHead, m.x - 10, m.y - 10, 20, 20);
        ctx.restore();
      }
      ctx.globalAlpha = 1;
    }
  }

  class Comet {
    active = false;
    waitTimer = 38;
    elapsed = 0;
    duration = 8;
    startX = 0;
    startY = 0;
    endX = 0;
    endY = 0;
    ctrlX = 0;
    ctrlY = 0;
    width = 1;
    height = 1;
    sprites: Sprites;

    constructor(width: number, height: number, sprites: Sprites) {
      this.width = width;
      this.height = height;
      this.sprites = sprites;
    }

    resize(w: number, h: number): void {
      this.width = w;
      this.height = h;
    }

    spawn(): void {
      const leftToRight = Math.random() < 0.5;
      this.startX = leftToRight ? -60 : this.width + 60;
      this.endX = leftToRight ? this.width + 60 : -60;
      this.startY = this.height * (0.1 + Math.random() * 0.25);
      this.endY = this.height * (0.28 + Math.random() * 0.25);
      this.ctrlX = this.width * 0.5;
      this.ctrlY = Math.min(this.startY, this.endY) - this.height * 0.08;
      this.elapsed = 0;
      this.duration = 8;
      this.active = true;
    }

    posAt(t: number): Point {
      const u = 1 - t;
      return {
        x: u * u * this.startX + 2 * u * t * this.ctrlX + t * t * this.endX,
        y: u * u * this.startY + 2 * u * t * this.ctrlY + t * t * this.endY
      };
    }

    update(dt: number): void {
      if (!this.active) {
        this.waitTimer -= dt;
        if (this.waitTimer <= 0) {
          this.spawn();
        }
        return;
      }

      this.elapsed += dt;
      if (this.elapsed >= this.duration) {
        this.active = false;
        this.waitTimer = 45 + Math.random() * 30;
      }
    }

    draw(ctx: CanvasRenderingContext2D): void {
      if (!this.active) return;
      const t = Math.min(1, this.elapsed / this.duration);
      const head = this.posAt(t);
      const tailT = Math.max(0, t - 0.14);
      const tail = this.posAt(tailT);
      const midT = (t + tailT) * 0.5;
      const mid = this.posAt(midT);
      const fade = Math.sin(t * Math.PI);

      ctx.save();
      ctx.globalAlpha = 0.55 * fade;

      const grad = ctx.createLinearGradient(head.x, head.y, tail.x, tail.y);
      grad.addColorStop(0, 'rgba(186, 230, 253, 0.75)');
      grad.addColorStop(0.45, 'rgba(125, 211, 252, 0.25)');
      grad.addColorStop(1, 'rgba(99, 102, 241, 0)');
      ctx.strokeStyle = grad;
      ctx.lineWidth = 7;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(head.x, head.y);
      ctx.quadraticCurveTo(mid.x, mid.y - 6, tail.x, tail.y);
      ctx.stroke();

      ctx.drawImage(this.sprites.cometHead, head.x - 14, head.y - 14, 28, 28);
      ctx.restore();
      ctx.globalAlpha = 1;
    }
  }

  class Loop {
    canvas: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D;
    dpr = 1;
    width = 1;
    height = 1;
    sprites: Sprites;
    starfield: Starfield;
    constellations: Constellations;
    planet: Planet;
    satellites: Satellites;
    meteors: Meteors;
    comet: Comet;

    rafId = 0;
    lastTs = 0;
    simTime = 0;
    cursorX = 0;
    cursorY = 0;
    cursorActive = false;
    isFinePointer = false;
    reducedMotion = false;
    motionQuery: MediaQueryList;
    resizeTimer = 0;

    // Scroll journey state (cached outside rAF)
    scrollY = 0;
    maxScroll = 1;
    easedScrollProgress = 0;
    heroHorizonGlow: HTMLElement | null;
    nebulaDeepLayer: HTMLElement | null;

    // Warp burst state
    warpActive = false;
    warpElapsed = 0;
    lastWarpTriggerMs = -Infinity;
    warpButtons: NodeListOf<Element>;

    // Adaptive quality tracking
    slowAccumMs = 0;
    slowFramesTotalMs = 0;
    slowFrameCount = 0;
    degraded = false;

    constructor(canvas: HTMLCanvasElement) {
      this.canvas = canvas;
      this.ctx = canvas.getContext('2d')!;
      this.motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      this.reducedMotion = this.motionQuery.matches;
      this.isFinePointer = window.matchMedia('(pointer: fine)').matches;

      this.width = window.innerWidth || 1;
      this.height = window.innerHeight || 1;
      this.dpr = Math.min(window.devicePixelRatio || 1, 2);
      this.applyCanvasSize();
      this.updateScrollMetrics();

      this.heroHorizonGlow = document.getElementById('heroHorizonGlow');
      this.nebulaDeepLayer = document.getElementById('nebulaDeepLayer');
      this.warpButtons = document.querySelectorAll('.btn-camp-register');

      this.sprites = createSprites();
      this.starfield = new Starfield(this.width, this.height, this.sprites);
      this.constellations = new Constellations(this.width, this.height, this.sprites);
      this.constellations.enabled = !this.degraded;
      this.planet = new Planet(this.width, this.height);
      this.satellites = new Satellites(this.width, this.height, this.sprites);
      this.meteors = new Meteors(this.width, this.height, this.sprites);
      this.comet = new Comet(this.width, this.height, this.sprites);

      this.bindEvents();
      this.applyScrollVisuals(this.getTargetScrollProgress());
      if (this.reducedMotion) {
        this.drawStaticFrame();
      } else {
        this.start();
      }
    }

    applyCanvasSize(): void {
      this.canvas.width = Math.round(this.width * this.dpr);
      this.canvas.height = Math.round(this.height * this.dpr);
      this.ctx.setTransform(this.dpr, 0, 0, this.dpr, 0, 0);
    }

    updateScrollMetrics(): void {
      this.scrollY = window.scrollY || 0;
      this.maxScroll = Math.max(1, document.documentElement.scrollHeight - (window.innerHeight || 1));
    }

    getTargetScrollProgress(): number {
      return Math.max(0, Math.min(1, this.scrollY / this.maxScroll));
    }

    applyScrollVisuals(p: number): void {
      if (this.heroHorizonGlow) {
        const glowOpacity = Math.max(0, 1 - p / 0.25);
        this.heroHorizonGlow.style.opacity = glowOpacity.toFixed(3);
      }
      if (this.nebulaDeepLayer) {
        this.nebulaDeepLayer.style.opacity = Math.min(1, p * 1.1).toFixed(3);
      }
    }

    onScroll = (): void => {
      this.scrollY = window.scrollY || 0;
      if (this.reducedMotion) {
        this.easedScrollProgress = this.getTargetScrollProgress();
        this.applyScrollVisuals(this.easedScrollProgress);
        this.drawStaticFrame();
      }
    };

    onWarpTrigger = (): void => {
      if (this.reducedMotion) return;
      const now = performance.now();
      if (now - this.lastWarpTriggerMs < 3000) return;
      this.lastWarpTriggerMs = now;
      this.warpActive = true;
      this.warpElapsed = 0;
    };

    onResize = (): void => {
      window.clearTimeout(this.resizeTimer);
      this.resizeTimer = window.setTimeout(() => {
        this.width = window.innerWidth || 1;
        this.height = window.innerHeight || 1;
        this.dpr = Math.min(window.devicePixelRatio || 1, 2);
        this.isFinePointer = window.matchMedia('(pointer: fine)').matches;
        this.applyCanvasSize();
        this.updateScrollMetrics();

        const isMobile = this.width < 768;
        this.starfield.resize(this.width, this.height, isMobile);
        this.constellations.resize(this.width, this.height);
        this.planet.resize(this.width, this.height);
        this.satellites.resize(this.width, this.height);
        this.meteors.resize(this.width, this.height);
        this.comet.resize(this.width, this.height);
        this.constellations.enabled = !this.degraded;

        if (this.reducedMotion) {
          this.drawStaticFrame();
        }
      }, 150);
    };

    onMouseMove = (e: MouseEvent): void => {
      if (!this.isFinePointer) return;
      this.cursorX = e.clientX;
      this.cursorY = e.clientY;
      this.cursorActive = true;
      const nx = e.clientX / (this.width || 1) - 0.5;
      const ny = e.clientY / (this.height || 1) - 0.5;
      this.starfield.setMouseTarget(nx, ny);
    };

    onMouseLeave = (): void => {
      this.cursorActive = false;
    };

    onVisibilityChange = (): void => {
      if (document.hidden) {
        this.stop();
      } else if (!this.reducedMotion) {
        this.lastTs = 0;
        this.start();
      }
    };

    onMotionChange = (e: MediaQueryListEvent): void => {
      this.reducedMotion = e.matches;
      if (this.reducedMotion) {
        this.warpActive = false;
        this.stop();
        this.drawStaticFrame();
      } else {
        this.lastTs = 0;
        this.start();
      }
    };

    bindEvents(): void {
      window.addEventListener('resize', this.onResize, { passive: true });
      window.addEventListener('scroll', this.onScroll, { passive: true });
      window.addEventListener('mousemove', this.onMouseMove, { passive: true });
      document.addEventListener('mouseleave', this.onMouseLeave);
      document.addEventListener('visibilitychange', this.onVisibilityChange);
      this.motionQuery.addEventListener('change', this.onMotionChange);

      this.warpButtons.forEach((btn) => {
        btn.addEventListener('pointerenter', this.onWarpTrigger, { passive: true });
        btn.addEventListener('pointerdown', this.onWarpTrigger, { passive: true });
      });
    }

    destroy(): void {
      this.stop();
      window.clearTimeout(this.resizeTimer);
      window.removeEventListener('resize', this.onResize);
      window.removeEventListener('scroll', this.onScroll);
      window.removeEventListener('mousemove', this.onMouseMove);
      document.removeEventListener('mouseleave', this.onMouseLeave);
      document.removeEventListener('visibilitychange', this.onVisibilityChange);
      this.motionQuery.removeEventListener('change', this.onMotionChange);

      this.warpButtons.forEach((btn) => {
        btn.removeEventListener('pointerenter', this.onWarpTrigger);
        btn.removeEventListener('pointerdown', this.onWarpTrigger);
      });
    }

    start(): void {
      if (this.rafId || this.reducedMotion || document.hidden) return;
      this.rafId = window.requestAnimationFrame(this.tick);
    }

    stop(): void {
      if (this.rafId) {
        window.cancelAnimationFrame(this.rafId);
        this.rafId = 0;
      }
      this.lastTs = 0;
    }

    drawStaticFrame(): void {
      this.ctx.clearRect(0, 0, this.width, this.height);
      const p = this.getTargetScrollProgress();
      this.starfield.update(0, this.scrollY, false);
      this.starfield.draw(this.ctx, 0, false, 0);
      this.constellations.updateAndDraw(this.ctx, 0, 0, this.starfield, 0, 0, false, this.isFinePointer, false, 0);
      this.planet.draw(this.ctx, 0, false, p);
    }

    checkAdaptiveQuality(frameMs: number): void {
      if (this.degraded || frameMs > 200) return;
      this.slowAccumMs += frameMs;
      this.slowFramesTotalMs += frameMs;
      this.slowFrameCount += 1;

      if (this.slowAccumMs >= 2000) {
        const avg = this.slowFramesTotalMs / Math.max(1, this.slowFrameCount);
        if (avg > 22) {
          this.degraded = true;
          this.starfield.reduceQuality();
          this.constellations.enabled = false;
        }
        this.slowAccumMs = 0;
        this.slowFramesTotalMs = 0;
        this.slowFrameCount = 0;
      }
    }

    getWarpFactor(dt: number): number {
      if (!this.warpActive) return 0;
      this.warpElapsed += dt;
      const duration = 0.6;
      if (this.warpElapsed >= duration) {
        this.warpActive = false;
        return 0;
      }
      const p = this.warpElapsed / duration;
      // Fast rise, smooth ease back
      return Math.pow(Math.sin(Math.PI * p), 1.4);
    }

    tick = (ts: number): void => {
      if (!this.lastTs) {
        this.lastTs = ts;
      }
      const rawMs = ts - this.lastTs;
      this.lastTs = ts;
      this.checkAdaptiveQuality(rawMs);

      const dt = Math.min(rawMs / 1000, 0.05);
      this.simTime += dt;

      const targetScroll = this.getTargetScrollProgress();
      const scrollLerp = 1 - Math.exp(-dt * 7);
      this.easedScrollProgress += (targetScroll - this.easedScrollProgress) * scrollLerp;
      this.applyScrollVisuals(this.easedScrollProgress);

      const warpFactor = this.getWarpFactor(dt);

      this.ctx.clearRect(0, 0, this.width, this.height);

      this.starfield.update(dt, this.scrollY, this.isFinePointer);
      this.starfield.draw(this.ctx, this.simTime, true, warpFactor);

      this.constellations.updateAndDraw(
        this.ctx,
        dt,
        this.simTime,
        this.starfield,
        this.cursorX,
        this.cursorY,
        this.cursorActive,
        this.isFinePointer,
        true,
        warpFactor
      );

      this.planet.draw(this.ctx, this.simTime, true, this.easedScrollProgress);

      this.satellites.update(dt);
      this.satellites.draw(this.ctx, this.simTime);

      const geminidRadiant = this.constellations.getGeminidRadiant(this.starfield);
      this.meteors.update(dt, geminidRadiant);
      this.meteors.draw(this.ctx);

      this.comet.update(dt);
      this.comet.draw(this.ctx);

      this.rafId = window.requestAnimationFrame(this.tick);
    };
  }

  class CardSpotlights {
    cards: NodeListOf<HTMLElement>;
    rects = new WeakMap<HTMLElement, DOMRect>();
    cleanups: Array<() => void> = [];

    constructor() {
      this.cards = document.querySelectorAll<HTMLElement>('.glass-card');
      if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;

      this.cards.forEach((card) => {
        const onEnter = () => {
          this.rects.set(card, card.getBoundingClientRect());
          card.classList.add('is-spotlight-active');
        };
        const onMove = (e: PointerEvent) => {
          const rect = this.rects.get(card);
          if (!rect) return;
          card.style.setProperty('--mx', `${(e.clientX - rect.left).toFixed(1)}px`);
          card.style.setProperty('--my', `${(e.clientY - rect.top).toFixed(1)}px`);
        };
        const onLeave = () => {
          card.classList.remove('is-spotlight-active');
        };

        card.addEventListener('pointerenter', onEnter, { passive: true });
        card.addEventListener('pointermove', onMove, { passive: true });
        card.addEventListener('pointerleave', onLeave, { passive: true });

        this.cleanups.push(() => {
          card.removeEventListener('pointerenter', onEnter);
          card.removeEventListener('pointermove', onMove);
          card.removeEventListener('pointerleave', onLeave);
        });
      });
    }

    destroy(): void {
      this.cleanups.forEach((fn) => fn());
      this.cleanups = [];
    }
  }

  class EarlyBirdCountdown {
    panel: HTMLElement | null;
    grid: HTMLElement | null;
    closedMsg: HTMLElement | null;
    urgentTag: HTMLElement | null;
    liveStatus: HTMLElement | null;
    elDays: HTMLElement | null;
    elHours: HTMLElement | null;
    elMinutes: HTMLElement | null;
    elSeconds: HTMLElement | null;
    motionQuery: MediaQueryList;
    timerId = 0;
    lastValues = { d: '', h: '', m: '', s: '' };
    lastLiveDays = -1;
    hydrated = false;

    constructor() {
      this.panel = document.getElementById('earlyBirdPanel');
      this.grid = document.getElementById('countdownGrid');
      this.closedMsg = document.getElementById('countdownClosedMsg');
      this.urgentTag = document.getElementById('ebUrgentTag');
      this.liveStatus = document.getElementById('cdLiveStatus');
      this.elDays = document.getElementById('cdDays');
      this.elHours = document.getElementById('cdHours');
      this.elMinutes = document.getElementById('cdMinutes');
      this.elSeconds = document.getElementById('cdSeconds');
      this.motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

      document.addEventListener('visibilitychange', this.onVisibilityChange);
      this.update();
    }

    onVisibilityChange = (): void => {
      if (!document.hidden) {
        window.clearTimeout(this.timerId);
        this.update();
      }
    };

    destroy(): void {
      window.clearTimeout(this.timerId);
      document.removeEventListener('visibilitychange', this.onVisibilityChange);
    }

    setDigit(el: HTMLElement | null, val: string, key: 'd' | 'h' | 'm' | 's'): void {
      if (!el) return;
      if (this.lastValues[key] === val) return;
      el.textContent = val;

      if (this.hydrated && !this.motionQuery.matches) {
        el.classList.remove('is-ticking');
        void el.offsetWidth;
        el.classList.add('is-ticking');
      }
      this.lastValues[key] = val;
    }

    update = (): void => {
      const now = Date.now();
      const diff = TARGET - now;

      if (diff <= 0) {
        if (this.grid) this.grid.hidden = true;
        if (this.closedMsg) this.closedMsg.hidden = false;
        if (this.urgentTag) this.urgentTag.hidden = true;
        if (this.panel) this.panel.classList.remove('is-urgent');
        if (this.liveStatus && this.lastLiveDays !== -2) {
          this.liveStatus.textContent = 'Early bird registration closed. Regular registration is open.';
          this.lastLiveDays = -2;
        }
        return;
      }

      if (this.grid) this.grid.hidden = false;
      if (this.closedMsg) this.closedMsg.hidden = true;

      const isUrgent = diff < URGENCY_MS;
      if (this.panel) this.panel.classList.toggle('is-urgent', isUrgent);
      if (this.urgentTag) this.urgentTag.hidden = !isUrgent;

      const totalSec = Math.floor(diff / 1000);
      const days = Math.floor(totalSec / 86400);
      const hours = Math.floor((totalSec % 86400) / 3600);
      const minutes = Math.floor((totalSec % 3600) / 60);
      const seconds = totalSec % 60;

      const dStr = String(days).padStart(2, '0');
      const hStr = String(hours).padStart(2, '0');
      const mStr = String(minutes).padStart(2, '0');
      const sStr = String(seconds).padStart(2, '0');

      this.setDigit(this.elDays, dStr, 'd');
      this.setDigit(this.elHours, hStr, 'h');
      this.setDigit(this.elMinutes, mStr, 'm');
      this.setDigit(this.elSeconds, sStr, 's');
      this.hydrated = true;

      if (this.liveStatus && days !== this.lastLiveDays) {
        this.lastLiveDays = days;
        this.liveStatus.textContent = days === 0
          ? 'Early bird registration ends in less than 1 day.'
          : `Early bird registration ends in ${days} ${days === 1 ? 'day' : 'days'}.`;
      }

      const nextMs = Math.max(40, 1000 - (Date.now() % 1000));
      this.timerId = window.setTimeout(this.update, nextMs);
    };
  }

  let activeCosmos: Loop | null = null;
  let activeCountdown: EarlyBirdCountdown | null = null;
  let activeSpotlights: CardSpotlights | null = null;

  function initAstroCamp(): void {
    cleanupAstroCamp();
    applyGrainTexture();
    const canvas = document.getElementById('astro-cosmos-canvas') as HTMLCanvasElement | null;
    if (canvas) {
      activeCosmos = new Loop(canvas);
    }
    if (document.getElementById('earlyBirdPanel')) {
      activeCountdown = new EarlyBirdCountdown();
    }
    activeSpotlights = new CardSpotlights();
  }

  function cleanupAstroCamp(): void {
    if (activeCosmos) {
      activeCosmos.destroy();
      activeCosmos = null;
    }
    if (activeCountdown) {
      activeCountdown.destroy();
      activeCountdown = null;
    }
    if (activeSpotlights) {
      activeSpotlights.destroy();
      activeSpotlights = null;
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAstroCamp, { once: true });
  } else {
    initAstroCamp();
  }
  document.addEventListener('astro:page-load', initAstroCamp);
  document.addEventListener('astro:before-swap', cleanupAstroCamp);
</script>
