          ? 0.58 + 0.42 * Math.sin(timeSec * s.freq * Math.PI * 2 + s.phase)
          : 0.85;
        const alpha = Math.max(0.18, Math.min(1, s.baseAlpha * twinkle));

        if (warpFactor > 0.01) {
          const depthWeight = s.layer === 0 ? 0.5 : s.layer === 1 ? 1.0 : 1.7;
          this.drawWarpStreak(ctx, sx, sy, depthWeight, warpFactor, s.color, alpha);
        }

        if (s.layer === 2) {
          ctx.globalAlpha = alpha;
          const size = s.radius * 11;
          const sprite = s.warm ? this.sprites.spikeStarWarm : this.sprites.spikeStar;
          ctx.drawImage(sprite, sx - size / 2, sy - size / 2, size, size);
        } else if (s.layer === 1) {
          ctx.globalAlpha = alpha * 0.72;
          const glowSize = s.radius * 8;
          const sprite = s.warm ? this.sprites.warmStarGlow : this.sprites.softStarGlow;
          ctx.drawImage(sprite, sx - glowSize / 2, sy - glowSize / 2, glowSize, glowSize);
          ctx.globalAlpha = alpha;
          ctx.fillStyle = s.color;
          ctx.beginPath();
          ctx.arc(sx, sy, s.radius, 0, Math.PI * 2);
          ctx.fill();
        } else {
          ctx.globalAlpha = alpha;
          ctx.fillStyle = s.color;
          ctx.beginPath();
          ctx.arc(sx, sy, s.radius, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      ctx.globalAlpha = 1;
    }
  }

  interface SkyStarDef {
    id: string;
    raH: number;
    decDeg: number;
    radius: number;
    color: string;
    spike?: 'cool' | 'warm';
    phase: number;
  }

  interface SkyConstellationDef {
    name: string;
    stars: SkyStarDef[];
    lines: Array<[string, string]>;
    labelAnchor: { raH: number; decDeg: number };
    lineAlpha: number;
  }

  interface EdgeFade {
    x1: number;
    y1: number;
    x2: number;
    y2: number;
    alpha: number;
    target: number;
  }

  class Constellations {
    edges = new Map<string, EdgeFade>();
    enabled = true;
    skyGroups: SkyConstellationDef[];
    sprites: Sprites;
    width = 1;
    height = 1;

    constructor(width: number, height: number, sprites: Sprites) {
      this.width = width;
      this.height = height;
      this.sprites = sprites;
      this.skyGroups = this.createDecemberSky();
    }

    createDecemberSky(): SkyConstellationDef[] {
      const p = (id: string, raH: number, decDeg: number, radius: number, color: string, spike?: 'cool' | 'warm'): SkyStarDef => ({
        id,
        raH,
        decDeg,
        radius,
        color,
        spike,
        phase: Math.random() * Math.PI * 2
      });

      const orion: SkyConstellationDef = {
        name: 'ORION',
        lineAlpha: 0,
        labelAnchor: { raH: 5.58, decDeg: -12.4 },
        stars: [
          p('betelgeuse', 5.92, 7.41, 2.35, '#ffb066', 'warm'),
          p('rigel', 5.24, -8.20, 2.40, '#bfe0ff', 'cool'),
          p('bellatrix', 5.42, 6.35, 1.55, '#cfe3ff'),
          p('mintaka', 5.53, -0.30, 1.40, '#dbeafe'),
          p('alnilam', 5.60, -1.20, 1.55, '#dbeafe'),
          p('alnitak', 5.68, -1.94, 1.45, '#dbeafe'),
          p('saiph', 5.80, -9.67, 1.40, '#cfe3ff'),
          p('meissa', 5.59, 9.93, 1.15, '#e2e8f0')
        ],
        lines: [
          ['meissa', 'betelgeuse'],
          ['meissa', 'bellatrix'],
          ['betelgeuse', 'bellatrix'],
          ['betelgeuse', 'alnitak'],
          ['bellatrix', 'mintaka'],
          ['mintaka', 'alnilam'],
          ['alnilam', 'alnitak'],
          ['mintaka', 'rigel'],
          ['alnitak', 'saiph'],
          ['rigel', 'saiph']
        ]
      };

      const taurus: SkyConstellationDef = {
        name: 'TAURUS',
        lineAlpha: 0,
        labelAnchor: { raH: 4.18, decDeg: 13.0 },
        stars: [
          p('aldebaran', 4.60, 16.51, 2.30, '#ffb066', 'warm'),
          p('elnath', 5.44, 28.61, 1.55, '#cfe3ff'),
          p('zeta_tau', 5.63, 21.14, 1.30, '#dbeafe'),
          p('ain', 4.48, 19.18, 1.25, '#ffe9c4'),
          p('delta_tau', 4.38, 17.54, 1.15, '#ffe9c4'),
          p('gamma_tau', 4.33, 15.63, 1.15, '#ffe9c4'),
          p('theta_tau', 4.48, 15.87, 1.15, '#ffe9c4'),
          // Pleiades cluster (M45)
          p('m45_alcyone', 3.79, 24.12, 1.25, '#dbeafe'),
          p('m45_atlas', 3.82, 24.05, 1.0, '#cfe3ff'),
          p('m45_electra', 3.75, 24.11, 1.0, '#cfe3ff'),
          p('m45_maia', 3.76, 24.37, 1.05, '#dbeafe'),
          p('m45_merope', 3.77, 23.95, 0.95, '#cfe3ff'),
          p('m45_taygeta', 3.75, 24.47, 0.9, '#e2e8f0'),
          p('m45_pleione', 3.82, 24.14, 0.85, '#e2e8f0')
        ],
        lines: [
          ['elnath', 'ain'],
          ['ain', 'delta_tau'],
          ['delta_tau', 'gamma_tau'],
          ['gamma_tau', 'theta_tau'],
          ['theta_tau', 'aldebaran'],
          ['aldebaran', 'zeta_tau']
        ]
      };

      const gemini: SkyConstellationDef = {
        name: 'GEMINI',
        lineAlpha: 0,
        labelAnchor: { raH: 7.05, decDeg: 33.8 },
        stars: [
          p('castor', 7.58, 31.89, 2.05, '#cfe3ff', 'cool'),
          p('pollux', 7.76, 28.03, 2.20, '#ffd8a8', 'warm'),
          p('alhena', 6.63, 16.40, 1.50, '#e2e8f0'),
          p('mebsuta', 6.73, 25.13, 1.30, '#ffe9c4'),
          p('tejat', 6.38, 22.51, 1.25, '#ffd8a8'),
          p('propus', 6.25, 22.50, 1.10, '#ffd8a8'),
          p('wasat', 7.34, 21.98, 1.20, '#e2e8f0'),
          p('mekbuda', 7.07, 20.57, 1.20, '#ffe9c4')
        ],
        lines: [
          ['castor', 'pollux'],
          ['castor', 'mebsuta'],
          ['mebsuta', 'tejat'],
          ['tejat', 'propus'],
          ['pollux', 'wasat'],
          ['wasat', 'mekbuda'],
          ['mekbuda', 'alhena']
