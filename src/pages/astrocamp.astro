---
import Base from '../layouts/Base.astro';

const registrationUrl = "https://forms.gle/JbWs9y6YBWRdamHN6";

const keySegments = [
  {
    icon: "🔭",
    title: "Astronomy Olympiad",
    desc: "Rigorous divisional competition with direct qualification pathway to BSCF's National Astronomy Camp."
  },
  {
    icon: "🌌",
    title: "Expert-Led Sessions",
    desc: "Interactive keynotes and masterclasses conducted by astronomy pioneers, academics, and researchers."
  },
  {
    icon: "🚀",
    title: "Hands-On Group Projects & Field Visit",
    desc: "Team collaborative mission challenges, observational night-sky stargazing, and guided scientific field visits."
  },
  {
    icon: "🤖",
    title: "Future-Ready Tech & Ethics",
    desc: "Cutting-edge workshops exploring Robotics Engineering, Empathy, and Responsible Social Media & AI Usage."
  },
  {
    icon: "🎒",
    title: "Participant Kit & Recognition",
    desc: "Official camp T-shirt, ID card, bag, notebook & pen, souvenir magazine, and certificate (plus medals, crests, and trophies for Olympiad winners)."
  }
];
---

<Base 
  title="3rd BSCF National Astronomy Camp, 2026 | Official Registration Portal" 
  description="Official registration portal for the 3rd BSCF National Astronomy Camp, 2026 (31 Dec – 2 Jan) at the University of Rajshahi. 3 days of space science, Astronomy Olympiad, robotics, AI, and national camp qualification."
  pageUrl="/astrocamp/"
>
  <div class="camp-page-wrapper">
    <canvas id="astro-cosmos-canvas" aria-hidden="true"></canvas>

    <!-- CSS Base & Breathing Nebula Layer (behind canvas) -->
    <div class="cosmos-base-bg" id="cosmosBaseBg" aria-hidden="true">
      <div class="nebula-layer nebula-layer-early">
        <div class="nebula-blob nebula-indigo"></div>
        <div class="nebula-blob nebula-teal"></div>
        <div class="nebula-blob nebula-amber"></div>
      </div>
      <div class="nebula-layer nebula-layer-deep" id="nebulaDeepLayer">
        <div class="nebula-blob nebula-deep-violet"></div>
        <div class="nebula-blob nebula-deep-amber"></div>
      </div>
    </div>

    <!-- Cinematic Vignette & Film Grain Overlays (above canvas, below content) -->
    <div class="cosmos-vignette-overlay" aria-hidden="true"></div>
    <div class="cosmos-grain-overlay" id="cosmosGrainOverlay" aria-hidden="true"></div>

    <div class="camp-content-container">

      <!-- Hero Header & Quick Registration CTA -->
      <div class="camp-header">
        <div class="camp-tag-badge">
          <span class="badge-dot"></span>
          <span>3RD EDITION • FLAGSHIP SCIENCE INITIATIVE</span>
        </div>

        <h1 class="camp-title">
          3rd BSCF <span class="gradient-text">National Astronomy Camp</span>, 2026
        </h1>
        <p class="camp-tagline">“From Stardust We're Born, To Constellations We Belong”</p>

        <p class="camp-organizer">
          Organized by <strong>Bangladesh Socio-Cultural Forum (BSCF)</strong>
        </p>

        <!-- Quick Key Info Strip -->
        <div class="camp-info-strip glass-card">
          <div class="info-strip-item">
            <span class="info-icon">📅</span>
            <div class="info-text">
              <span class="info-label">Date</span>
              <strong class="info-val">31 Dec – 2 Jan</strong>
              <span class="info-sub">3 Days (Non-Residential)</span>
            </div>
          </div>

          <div class="info-strip-item">
            <span class="info-icon">🏛</span>
            <div class="info-text">
              <span class="info-label">Venue</span>
              <strong class="info-val">University of Rajshahi</strong>
              <span class="info-sub">Rajshahi, Bangladesh</span>
            </div>
          </div>
        </div>

        <!-- Live Early Bird Countdown Panel -->
        <div class="early-bird-panel glass-card" id="earlyBirdPanel">
          <div class="countdown-border-ring" aria-hidden="true"></div>

          <div class="early-bird-header">
            <span class="early-bird-title">⚡ EARLY BIRD REGISTRATION ENDS IN</span>
            <span class="eb-urgent-tag" id="ebUrgentTag" hidden>Ending soon</span>
          </div>
          <p class="early-bird-sub">
            Deadline: 10 December 2026 • 11:59 PM Bangladesh Time (UTC+6)
          </p>

          <div class="countdown-grid" id="countdownGrid" aria-hidden="true">
            <div class="cd-unit">
              <div class="cd-digit-box">
                <span class="cd-val" id="cdDays">--</span>
              </div>
              <span class="cd-label">DAYS</span>
            </div>

            <span class="cd-colon" aria-hidden="true">:</span>

            <div class="cd-unit">
              <div class="cd-digit-box">
                <span class="cd-val" id="cdHours">--</span>
              </div>
              <span class="cd-label">HOURS</span>
            </div>

            <span class="cd-colon" aria-hidden="true">:</span>

            <div class="cd-unit">
              <div class="cd-digit-box">
                <span class="cd-val" id="cdMinutes">--</span>
              </div>
              <span class="cd-label">MINUTES</span>
            </div>

            <span class="cd-colon" aria-hidden="true">:</span>

            <div class="cd-unit">
              <div class="cd-digit-box">
                <span class="cd-val" id="cdSeconds">--</span>
              </div>
              <span class="cd-label">SECONDS</span>
            </div>
          </div>

          <p class="countdown-closed-msg" id="countdownClosedMsg" hidden>
            Early Bird Registration Closed — Regular Registration Open!
          </p>
          <p class="sr-only" id="cdLiveStatus" aria-live="polite"></p>
        </div>

        <!-- Primary CTA Button -->
        <div class="camp-hero-cta">
          <a 
            href={registrationUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn-camp-register"
          >
            <span>Register Now</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

        <!-- Hero Bottom Warm Horizon Glow & Silhouette Ridge (scrolls with hero) -->
        <div class="hero-horizon-wrap" aria-hidden="true">
          <div class="hero-horizon-glow" id="heroHorizonGlow"></div>
          <svg
            class="hero-horizon-svg"
            viewBox="0 0 1440 90"
            preserveAspectRatio="xMidYMax slice"
            xmlns="http://www.w3.org/2000/svg"
          >
            <defs>
              <radialGradient id="tentLanternGlow" cx="50%" cy="65%" r="55%">
                <stop offset="0%" stop-color="#fbbf24" stop-opacity="0.72" />
                <stop offset="45%" stop-color="#f59e0b" stop-opacity="0.28" />
                <stop offset="100%" stop-color="#f59e0b" stop-opacity="0" />
              </radialGradient>
            </defs>

            <!-- Soft ambient lantern halo on the middle tent -->
            <circle cx="964" cy="64" r="24" fill="url(#tentLanternGlow)" class="lantern-halo" />

            <!-- Ridge silhouette -->
            <path
              d="M0,90 L0,64 C110,58 190,48 295,55 C395,62 465,44 570,50 C665,56 755,66 860,57 C955,49 1030,42 1135,51 C1245,60 1345,48 1440,56 L1440,90 Z"
              fill="#02040a"
            />

            <!-- Left campsite: 2 tiny tent silhouettes -->
            <polygon points="348,60 364,43 380,60" fill="#02040a" />
            <polygon points="386,61 399,48 412,61" fill="#02040a" />

            <!-- Refractor telescope on tripod -->
            <g fill="#02040a" stroke="#02040a" stroke-linecap="round">
              <!-- Tripod legs -->
              <line x1="518" y1="38" x2="509" y2="54" stroke-width="1.6" />
              <line x1="518" y1="38" x2="518" y2="54" stroke-width="1.4" />
              <line x1="518" y1="38" x2="527" y2="54" stroke-width="1.6" />
              <!-- Mount head -->
              <circle cx="518" cy="37" r="2" />
              <!-- Tilted refractor optical tube + eyepiece -->
              <line x1="510" y1="41" x2="531" y2="27" stroke-width="3.2" />
              <line x1="507" y1="43" x2="511" y2="40" stroke-width="1.8" />
            </g>

            <!-- Right campsite: lantern-lit tent -->
            <polygon points="944,68 964,46 984,68" fill="#02040a" />
            <polygon points="960,68 964,56 968,68" fill="#fbbf24" class="lantern-door" />
          </svg>
        </div>
      </div>

      <!-- Concise About & Program Highlights -->
      <section class="camp-about-section glass-card">
        <h2 class="section-title">About the Camp</h2>
        <div class="section-line"></div>

        <div class="about-paragraphs">
          <p>
            Following the tremendous success of the 1st BSCF Astronomy Camp 2024 (350+ participants) and the 2nd BSCF Divisional Astronomy Camp 2025 (1,200+ participants), the <strong>3rd BSCF National Astronomy Camp, 2026</strong> brings together students from schools, colleges, and universities across the country to the University of Rajshahi from <strong>31 December – 2 January</strong> for three days of immersive, hands-on space science and STEM exploration.
          </p>
          <p>
            The camp takes astronomy out of traditional textbooks into practical discovery. Outstanding performers and winners of the Divisional Astronomy Olympiad also qualify directly for <strong>BSCF's National Astronomy Camp</strong>, establishing a prestigious division-wide qualification pathway to nationwide exposure, scientific mentorship, and advanced astrophysics training.
          </p>
        </div>
      </section>

      <!-- Key Segments & Participant Perks -->
      <section class="camp-segments-section">
        <h2 class="section-title">Key Segments & Participant Perks</h2>
        <div class="section-line"></div>

        <div class="segments-grid">
          {keySegments.map(item => (
            <div class="segment-card glass-card">
              <span class="segment-icon">{item.icon}</span>
              <div class="segment-body">
                <h3 class="segment-title">{item.title}</h3>
                <p class="segment-desc">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Camp Leadership Card -->
      <section class="camp-leadership-section">
        <div class="leadership-card glass-card">
          <div class="leader-col">
            <span class="role-tag">Camp Adviser</span>
            <h4 class="person-name">Dr. Md. Mahbubor Rahman</h4>
            <p class="person-title">Proctor, University of Rajshahi</p>
          </div>

          <div class="leader-col divider-left">
            <span class="role-tag">Chief Executive, BSCF</span>
            <h4 class="person-name">Niloy Saha</h4>
            <p class="person-title">Bangladesh Socio-Cultural Forum</p>
          </div>
        </div>
      </section>

      <!-- Closing Registration CTA -->
      <div class="camp-closing-cta">
        <a 
          href={registrationUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-camp-register large"
        >
          <span>Register Now</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

    </div>
  </div>
</Base>

<style>
/* ===================================================
   3rd BSCF Astronomy Camp 2026 - Deep-Space Interactive Theme
   =================================================== */

.camp-page-wrapper {
  position: relative;
  z-index: 0;
  isolation: isolate;
  background: linear-gradient(180deg, #030712 0%, #070d1f 52%, #0b132b 100%);
  color: #f1f5f9;
  min-height: 100vh;
  padding: 105px 20px 80px; /* Ample top clearance below fixed navbar */
  font-family: 'Jost', sans-serif;
  overflow-x: clip;
}

#astro-cosmos-canvas {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

/* CSS Base Nebula Layer (sits behind canvas inside isolated stacking context) */
.cosmos-base-bg {
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  overflow: hidden;
}

.nebula-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
  will-change: opacity;
}

.nebula-layer-early {
  opacity: 1;
}

.nebula-layer-deep {
  opacity: 0;
}

.nebula-blob {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  will-change: transform, opacity;
}

.nebula-indigo {
  width: min(72vw, 760px);
  height: min(72vw, 760px);
  top: -12%;
  left: -10%;
  background: radial-gradient(circle, rgba(59, 42, 140, 0.9) 0%, rgba(59, 42, 140, 0.35) 38%, transparent 72%);
  opacity: 0.13;
  animation: nebulaBreatheA 22s ease-in-out infinite;
}

.nebula-teal {
  width: min(68vw, 720px);
  height: min(68vw, 720px);
  top: 22%;
  right: -12%;
  background: radial-gradient(circle, rgba(14, 116, 144, 0.9) 0%, rgba(14, 116, 144, 0.32) 40%, transparent 72%);
  opacity: 0.11;
  animation: nebulaBreatheB 26s ease-in-out infinite;
}

.nebula-amber {
  width: min(62vw, 640px);
  height: min(62vw, 640px);
  bottom: -14%;
  left: 14%;
  background: radial-gradient(circle, rgba(180, 83, 9, 0.85) 0%, rgba(180, 83, 9, 0.28) 38%, transparent 72%);
  opacity: 0.09;
  animation: nebulaBreatheC 29s ease-in-out infinite;
}

.nebula-deep-violet {
  width: min(76vw, 800px);
  height: min(76vw, 800px);
  top: 8%;
  left: -8%;
  background: radial-gradient(circle, rgba(109, 40, 217, 0.9) 0%, rgba(76, 29, 149, 0.35) 40%, transparent 72%);
  opacity: 0.13;
  animation: nebulaBreatheA 24s ease-in-out infinite;
}

.nebula-deep-amber {
  width: min(70vw, 720px);
  height: min(70vw, 720px);
  bottom: -10%;
  right: -8%;
  background: radial-gradient(circle, rgba(217, 119, 6, 0.85) 0%, rgba(180, 83, 9, 0.3) 40%, transparent 72%);
  opacity: 0.11;
  animation: nebulaBreatheB 28s ease-in-out infinite;
}

@keyframes nebulaBreatheA {
  0%, 100% { opacity: 0.10; transform: translate3d(0, 0, 0) scale(1); }
  50% { opacity: 0.14; transform: translate3d(2%, 3%, 0) scale(1.07); }
}

@keyframes nebulaBreatheB {
  0%, 100% { opacity: 0.09; transform: translate3d(0, 0, 0) scale(1.03); }
  50% { opacity: 0.13; transform: translate3d(-3%, -2%, 0) scale(0.96); }
}

@keyframes nebulaBreatheC {
  0%, 100% { opacity: 0.08; transform: translate3d(0, 0, 0) scale(0.98); }
  50% { opacity: 0.12; transform: translate3d(2%, -2%, 0) scale(1.06); }
}

/* Cinematic Vignette & Film Grain Overlays (above canvas, below content) */
.cosmos-vignette-overlay {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background: radial-gradient(ellipse at 50% 45%, rgba(3, 7, 18, 0) 56%, rgba(2, 4, 12, 0.28) 100%);
}

.cosmos-grain-overlay {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  opacity: 0.04;
  mix-blend-mode: overlay;
  background-repeat: repeat;
  background-size: 128px 128px;
  animation: grainShift 0.5s steps(4, end) infinite;
}

@keyframes grainShift {
  0% { background-position: 0 0; }
  25% { background-position: 32px -24px; }
  50% { background-position: -48px 40px; }
  75% { background-position: 20px 56px; }
  100% { background-position: 0 0; }
}

/* Keep site footer above the fixed canvas */
:global(body:has(#astro-cosmos-canvas) .footer-container) {
  position: relative;
  z-index: 1;
}

.camp-content-container {
  position: relative;
  z-index: 1;
  max-width: 880px;
  margin: 0 auto;
}

/* Shared Glassmorphism Card Surface + Desktop Cursor Spotlight */
.glass-card {
  position: relative;
  background: rgba(10, 17, 36, 0.72);
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 18px;
  backdrop-filter: blur(10px) saturate(120%);
  -webkit-backdrop-filter: blur(10px) saturate(120%);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.06),
    0 18px 42px rgba(2, 6, 23, 0.55);
}

@supports not (backdrop-filter: blur(1px)) {
  .glass-card {
    background: rgba(10, 17, 36, 0.9);
  }
}

@media (hover: hover) and (pointer: fine) {
  .glass-card::before,
  .glass-card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.28s ease;
  }

  /* Subtle inner spotlight glow */
  .glass-card::before {
    background: radial-gradient(
      220px circle at var(--mx, -999px) var(--my, -999px),
      rgba(56, 189, 248, 0.075),
      rgba(251, 191, 36, 0.04) 45%,
      transparent 75%
    );
  }

  /* Masked radial border highlight */
  .glass-card::after {
    padding: 1px;
    background: radial-gradient(
      220px circle at var(--mx, -999px) var(--my, -999px),
      rgba(45, 212, 191, 0.36),
      rgba(251, 191, 36, 0.30) 48%,
      transparent 75%
    );
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
  }

  .glass-card.is-spotlight-active::before,
  .glass-card.is-spotlight-active::after {
    opacity: 1;
  }
}

/* Header Area */
.camp-header {
  text-align: center;
  margin-bottom: 34px;
}

.camp-tag-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(14, 116, 144, 0.22);
  border: 1px solid rgba(56, 189, 248, 0.35);
  color: #bae6fd;
  padding: 6px 16px;
  border-radius: 50px;
  font-size: 0.76rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  margin-bottom: 16px;
}

.badge-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #38bdf8;
  box-shadow: 0 0 8px #38bdf8;
  animation: beaconGlow 1.8s infinite ease-in-out;
}

@keyframes beaconGlow {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.35); opacity: 0.6; }
}

.camp-title {
  font-size: clamp(2rem, 5vw, 3.1rem);
  font-weight: 800;
  color: #ffffff;
  line-height: 1.2;
  margin-bottom: 10px;
  letter-spacing: -0.01em;
  text-shadow: 0 2px 18px rgba(3, 7, 18, 0.65);
}

.gradient-text {
  background: linear-gradient(135deg, #38bdf8 0%, #c084fc 50%, #fbbf24 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.camp-tagline {
  font-size: clamp(1rem, 2.3vw, 1.3rem);
  color: #e2e8f0;
  font-style: italic;
  font-weight: 400;
  margin-bottom: 14px;
}

.camp-organizer {
  font-size: 0.95rem;
  color: #cbd5e1;
  line-height: 1.5;
  margin-bottom: 26px;
}

.camp-organizer strong {
  color: #ffffff;
}

/* Quick Key Info Strip */
.camp-info-strip {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
  max-width: 640px;
  margin: 0 auto 22px;
  padding: 18px 22px;
  text-align: left;
}

.info-strip-item {
  display: flex;
  align-items: center;
  gap: 12px;
}

.info-icon {
  font-size: 1.7rem;
  flex-shrink: 0;
}

.info-text {
  display: flex;
  flex-direction: column;
}

.info-label {
  font-size: 0.7rem;
  text-transform: uppercase;
  color: #cbd5e1;
  letter-spacing: 0.08em;
  font-weight: 600;
}

.info-val {
  font-size: 0.98rem;
  color: #ffffff;
  font-weight: 700;
  line-height: 1.25;
}

.info-sub {
  font-size: 0.76rem;
  color: #7dd3fc;
  margin-top: 2px;
}

/* Early Bird Countdown Panel */
.early-bird-panel {
  position: relative;
  max-width: 640px;
  margin: 0 auto 24px;
  padding: 20px 22px 22px;
  border-radius: 20px;
  border-color: transparent;
}

.countdown-border-ring {
  position: absolute;
  inset: 0;
  padding: 1.5px;
  border-radius: 20px;
  pointer-events: none;
  overflow: hidden;
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  mask-composite: exclude;
}

.countdown-border-ring::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  width: 200%;
  aspect-ratio: 1;
  transform: translate(-50%, -50%) rotate(0deg);
  background: conic-gradient(
    from 0deg,
    rgba(99, 102, 241, 0.72) 0deg,
    rgba(20, 184, 166, 0.75) 120deg,
    rgba(245, 158, 11, 0.72) 240deg,
    rgba(99, 102, 241, 0.72) 360deg
  );
  animation: countdownBorderSpin 8s linear infinite;
}

@keyframes countdownBorderSpin {
  to {
    transform: translate(-50%, -50%) rotate(360deg);
  }
}

.early-bird-panel.is-urgent {
  box-shadow:
    inset 0 1px 0 rgba(251, 191, 36, 0.14),
    0 18px 42px rgba(2, 6, 23, 0.55),
    0 0 28px rgba(245, 158, 11, 0.22);
}

.early-bird-panel.is-urgent .countdown-border-ring::before {
  background: conic-gradient(
    from 0deg,
    rgba(245, 158, 11, 0.9) 0deg,
    rgba(251, 191, 36, 0.95) 120deg,
    rgba(234, 88, 12, 0.85) 240deg,
    rgba(245, 158, 11, 0.9) 360deg
  );
}

.countdown-grid[hidden],
.eb-urgent-tag[hidden],
.countdown-closed-msg[hidden] {
  display: none !important;
}

.early-bird-header {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 4px;
}

.early-bird-title {
  font-size: 0.8rem;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #fde68a;
}

.eb-urgent-tag {
  display: inline-flex;
  align-items: center;
  padding: 2px 10px;
  border-radius: 999px;
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  background: rgba(245, 158, 11, 0.22);
  border: 1px solid rgba(251, 191, 36, 0.55);
  color: #fef3c7;
}

.early-bird-sub {
